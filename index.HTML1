<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Восточный</title>

<style>
body{margin:0;font-family:sans-serif;background:#0a0712;color:white}
.container{width:90%;margin:auto}

/* HERO */
.hero{
height:100vh;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
background:linear-gradient(rgba(10,5,20,.8),rgba(0,0,0,.9)),
url('https://images.unsplash.com/photo-1544161515-4ab6ce6db874') center/cover;
}

h1{font-size:40px}

.btn{
background:linear-gradient(45deg,#8e4cff,#d4af37);
padding:15px 30px;
border:none;
color:white;
border-radius:30px;
cursor:pointer;
}

section{padding:80px 0;text-align:center}

.services{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
gap:20px;
}

.service{
background:#1b142b;
padding:20px;
border-radius:10px;
}

.portfolio img{
width:100%;
max-width:300px;
margin:10px;
border-radius:10px;
}

.testimonial{display:none}
.testimonial.active{display:block}

input,textarea{
width:100%;
padding:10px;
margin:5px 0;
background:#1b142b;
border:none;
color:white;
}

footer{padding:20px;text-align:center;color:#aaa}

</